{
  "name": "yasmeen",
  "productName": "Yasmeen",
  "version": "0.1.0",
  "description": "Menu bar manager for same-user listening TCP ports on macOS.",
  "main": "dist/electron/main.js",
  "author": "Zahra",
  "license": "MIT",
  "scripts": {
    "icons": "node scripts/render-icon.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/bundle-renderer.mjs",
    "test": "npm run build && node --test dist/tests/unit/lib/listeners/*.test.js dist/tests/unit/application/*.test.js",
    "dev": "npm run build && electron .",
    "preview": "npm run build && WHARF_PREVIEW=1 electron .",
    "pack": "npm run icons && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac"
  },
  "build": {
    "appId": "com.zahra.yasmeen",
    "productName": "Yasmeen",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**/*",
      "dist/lib/**/*",
      "!dist/**/*.map",
      "!dist/tests/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        "dir",
        "dmg"
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSHighResolutionCapable": true
      }
    },
    "dmg": {
      "title": "Install Yasmeen"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
